# ── Data providers ─────────────────────────────────────────────────────────
# Season to display. "current" follows the provider's current season.
F1_SEASON=current

# Championship / results / calendar data (Jolpica, Ergast-compatible, free, no key).
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Live timing, weather, race control, photos (OpenF1).
OPENF1_BASE_URL=https://api.openf1.org/v1

# OpenF1 bearer token. Historical data works without it, but OpenF1 only serves
# real-time data during a live session to authenticated (paid) users.
# Without it the app shows "Live timing unavailable" during a Grand Prix instead
# of inventing numbers.
F1_API_KEY=
